---
import type { Page } from "astro";

interface Props {
  page: Page<any>;
}

const { page } = Astro.props;

const prev = page.url.prev;
const next = page.url.next;
---

{page.lastPage > 1 && (
  <nav aria-label="Blog pagination" class="pagination gutter">
    {prev ? (
      <a href={prev} class="page-btn" rel="prev">← previous</a>
    ) : (
      <span class="page-btn disabled" aria-disabled="true">← previous</span>
    )}

    <span class="page-count">
      {String(page.currentPage).padStart(2, '0')} / {String(page.lastPage).padStart(2, '0')}
    </span>

    {next ? (
      <a href={next} class="page-btn" rel="next">next →</a>
    ) : (
      <span class="page-btn disabled" aria-disabled="true">next →</span>
    )}
  </nav>
)}

<style>
.pagination {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding-top: 20px;
  padding-bottom: 20px;
  border-bottom: 1px solid var(--color-border);
}

.page-btn {
  padding: 10px 16px;
  border: 1px solid var(--color-border);
  font-size: 11px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  white-space: nowrap;
  transition: background 0.15s ease, color 0.15s ease;
}

a.page-btn:hover {
  background: var(--color-invert-bg);
  color: var(--color-invert-text);
}

.page-btn.disabled {
  color: var(--color-text-muted);
  opacity: 0.5;
  cursor: not-allowed;
}

.page-count {
  font-size: 10px;
  letter-spacing: 0.14em;
  color: var(--color-text-muted);
}
</style>
