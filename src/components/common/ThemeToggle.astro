---
import { Icon } from 'astro-icon/components'
---

<button
    id="toggle-theme-button"
    type="button"
    aria-label="Toggle dark mode"
    class="theme-toggle"
>
    <span class="icon icon-sun" aria-hidden="true"><Icon name="Sun" /></span>
    <span class="icon icon-moon" aria-hidden="true"><Icon name="Moon" /></span>
</button>

<script>
    import { getNextTheme, setTheme } from "../../scripts/theme";

    document
        .getElementById('toggle-theme-button')
        ?.addEventListener('click', () => setTheme(getNextTheme()));
</script>

<style>
.theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    flex-shrink: 0;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-text-nav);
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
}

.theme-toggle:hover {
    background: var(--color-invert-bg);
    color: var(--color-invert-text);
    border-color: var(--color-invert-bg);
}

.icon {
    display: none;
    align-items: center;
    justify-content: center;
}

.icon :global(svg) {
    width: 15px;
    height: 15px;
}

/* Show the icon for the theme you'd switch *to* — no JS class juggling,
   so there's no flash before the toggle script hydrates. */
:global([data-theme="light"]) .icon-moon,
:global([data-theme="dark"]) .icon-sun {
    display: inline-flex;
}
</style>
