---
import { basic, menuItems } from "../../config/cv.json";

const path = Astro.url.pathname;
const isActive = (link: string) =>
  link === "/" ? path === "/" : path === link || path.startsWith(`${link}/`);
---

<header class="site-header">
  <a href="/" class="logo" aria-label={`${basic.domain} home`}>
    {basic.domain}<span class="caret" aria-hidden="true">_</span>
  </a>

  <nav class="nav" aria-label="Primary">
    {menuItems.map((item) => (
      <a
        href={item.link}
        class:list={["link-quiet", { active: isActive(item.link) }]}
        aria-current={isActive(item.link) ? "page" : undefined}
      >{item.name}</a>
    ))}
  </nav>
</header>

<style>
/* Three nav items and a short wordmark fit at 320px, so there is no
   mobile menu to hide behind. */
.site-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 24px;
}

.logo {
  display: inline-flex;
  align-items: baseline;
  font-family: var(--font-mono);
  font-size: 14px;
  letter-spacing: -0.01em;
}

.caret {
  color: var(--accent);
  animation: blink 1.2s step-end infinite;
}

.nav {
  display: flex;
  align-items: baseline;
  gap: 18px;
  font-family: var(--font-mono);
  font-size: 12.5px;
  color: var(--muted);
}

/* The page you are on reads at full strength; the others stay quiet. */
.nav .active {
  color: var(--ink);
}

@media (max-width: 380px) {
  .nav { gap: 14px; }
}
</style>
