---
import { basic, footerItems } from "../../config/cv.json";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <nav class="footer-nav" aria-label="Footer">
    {footerItems.map((item, i) => (
      <>
        {i > 0 && <span aria-hidden="true">·</span>}
        <a href={item.link} class="link-quiet">{item.name}</a>
      </>
    ))}
    <span aria-hidden="true">·</span>
    <a href={`mailto:${basic.email}`} class="link-quiet">email</a>
  </nav>

  <span class="footer-meta">
    <span>© {year} · Berlin</span>
    <span aria-hidden="true">·</span>
    <a
      href="https://github.com/smyrdev/smyr.dev"
      class="link-quiet repo"
      target="_blank"
      rel="noopener noreferrer"
      title="Source on GitHub"
      aria-label="Source on GitHub"
    >
      <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.3.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.8 0-1.3.5-2.3 1.2-3.2-.1-.3-.5-1.5.1-3 0 0 1-.3 3.3 1.2.9-.3 1.9-.4 2.9-.4s2 .1 2.9.4C17.4 4.5 18.4 4.8 18.4 4.8c.6 1.5.2 2.7.1 3 .8.9 1.2 1.9 1.2 3.2 0 4.5-2.7 5.5-5.3 5.8.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5z"/></svg>
    </a>
  </span>
</footer>

<style>
.site-footer {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12px 20px;
  flex-wrap: wrap;
  padding-top: 28px;
  border-top: 1px solid var(--line);
  font-family: var(--font-mono);
  font-size: 12px;
  color: var(--muted);
}

.footer-nav {
  display: flex;
  align-items: baseline;
  gap: 8px;
  flex-wrap: wrap;
}

/* An icon-only link has no text baseline of its own — left inline it would sit
   its bottom edge on the baseline and ride high. Centring it in a flex row
   against the copyright text is what puts it where the eye expects. */
.footer-meta {
  display: inline-flex;
  align-items: center;
  gap: 7px;
}

.repo {
  display: inline-flex;
}

/* kills the inline descender gap under the svg */
.repo svg {
  display: block;
}
</style>
