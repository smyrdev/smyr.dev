---
import { basic, footerItems } from "../../config/cv.json";

const year = new Date().getFullYear();
---

<footer class="site-footer gutter">
  <span class="footer-copy">© {year} {basic.name}</span>

  <nav class="footer-nav" aria-label="Footer">
    {footerItems.map(item => (
      <a href={item.link} class="footer-link">{item.name}</a>
    ))}
  </nav>

  <span class="footer-built">built static · astro</span>
</footer>

<style>
.site-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px 24px;
  flex-wrap: wrap;
  padding-top: 16px;
  padding-bottom: 16px;
  border-top: 1px solid var(--color-border);
  font-size: 10px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--color-text-muted);
}

.footer-nav {
  display: flex;
  gap: 16px;
  flex-wrap: wrap;
}

.footer-link {
  transition: color 0.15s ease;
}

.footer-link:hover {
  color: var(--color-primary);
}

@media (max-width: 720px) {
  .site-footer {
    justify-content: center;
    text-align: center;
    gap: 10px 20px;
  }

  .footer-nav {
    order: -1;
    justify-content: center;
    width: 100%;
    padding-bottom: 4px;
  }
}
</style>
