---
import { basic, footerItems } from "../../config/cv.json";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <nav class="footer-nav" aria-label="Footer">
    {footerItems.map((item, i) => (
      <>
        {i > 0 && <span aria-hidden="true">·</span>}
        <a href={item.link} class="link-quiet">{item.name}</a>
      </>
    ))}
    <span aria-hidden="true">·</span>
    <a href={`mailto:${basic.email}`} class="link-quiet">email</a>
  </nav>

  <span>© {year} · Astro</span>
</footer>

<style>
.site-footer {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12px 20px;
  flex-wrap: wrap;
  padding-top: 28px;
  border-top: 1px solid var(--line);
  font-family: var(--font-mono);
  font-size: 12px;
  color: var(--muted);
}

.footer-nav {
  display: flex;
  align-items: baseline;
  gap: 8px;
  flex-wrap: wrap;
}
</style>
