---
import { menuItems } from "../../config/cv.json";

const links = [{ name: "home", link: "/" }, ...menuItems];
---

<section class="notfound">
  <span class="code">404 / not found</span>

  <h1 class="page-title">Nothing to see here</h1>

  <p class="prose prose-muted">
    Everything that does exist is one of these:
  </p>

  <ul class="links">
    {links.map(item => (
      <li class="row">
        <span class="meta">{item.name}</span>
        <a href={item.link} class="link-underline">{item.link}</a>
      </li>
    ))}
  </ul>
</section>

<style>
.notfound {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.code {
  font-family: var(--font-mono);
  font-size: 11.5px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--muted);
}

.links {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-top: 6px;
  font-family: var(--font-mono);
  font-size: 13px;
}

.links a {
  justify-self: start;
}
</style>
