---
import type { CollectionEntry } from 'astro:content';

interface Props {
  work: CollectionEntry<'works'>;
  index: number;
}

const { work, index } = Astro.props;

const slug = work.id.replace(/\.mdx?$/, '');
const detail = `/works/${slug}`;

const links = [
  work.data.href && { label: work.data.linkLabel, href: work.data.href, external: true },
  work.data.repo && { label: 'source ↗', href: work.data.repo, external: true },
  { label: 'case study →', href: detail, external: false },
].filter(Boolean) as { label: string; href: string; external: boolean }[];
---

<article class="work-row">
  <span class="row-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>

  <div class="row-main">
    <div class="row-meta">
      <span class="row-type">{work.data.type}</span>
      {work.data.year && <span>{work.data.year}</span>}
      {work.data.status && <span>{work.data.status}</span>}
    </div>

    <h2 class="row-title">
      <a href={detail}>{work.data.title}</a>
    </h2>

    <p class="row-blurb">{work.data.blurb}</p>

    {work.data.stack.length > 0 && (
      <div class="stack">
        {work.data.stack.map(item => <span class="stack-item">{item}</span>)}
      </div>
    )}
  </div>

  <div class="row-links">
    {links.map(link => (
      <a
        href={link.href}
        class="row-link"
        target={link.external ? '_blank' : undefined}
        rel={link.external ? 'noopener noreferrer' : undefined}
      >{link.label}</a>
    ))}
  </div>
</article>

<style>
.work-row {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  gap: 24px;
  padding: 28px var(--page-gutter);
  border-bottom: 1px solid var(--color-border);
  transition: background 0.15s ease, color 0.15s ease;
}

.work-row:hover {
  background: var(--color-invert-bg);
  color: var(--color-invert-text);
}

.row-index {
  font-size: 10px;
  letter-spacing: 0.1em;
  color: var(--color-text-muted);
  padding-top: 4px;
}

.row-main {
  display: flex;
  flex-direction: column;
  gap: 10px;
  min-width: 0;
}

.row-meta {
  display: flex;
  align-items: baseline;
  gap: 12px;
  flex-wrap: wrap;
  font-size: 10px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--color-text-muted);
}

.row-type {
  color: var(--color-primary);
}

.row-title {
  font-family: var(--font-display);
  font-size: 28px;
  font-weight: 700;
  line-height: 1.08;
  letter-spacing: -0.03em;
  text-transform: none;
}

.row-title a {
  transition: color 0.15s ease;
}

.row-title a:hover {
  color: var(--color-primary);
}

.row-blurb {
  font-size: 13px;
  line-height: 1.7;
  color: var(--color-text-offset);
  max-width: 60ch;
}

.stack {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
  margin-top: 2px;
}

.stack-item {
  font-size: 10px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  border: 1px solid var(--color-border);
  padding: 2px 7px;
  color: var(--color-text-muted);
}

.row-links {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8px;
  font-size: 10px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  white-space: nowrap;
}

.row-link {
  color: var(--color-text-nav);
  transition: color 0.15s ease;
}

.row-link:hover {
  color: var(--color-primary);
}

/* Legibility once the row inverts. */
.work-row:hover .row-blurb {
  color: color-mix(in srgb, var(--color-invert-text) 72%, transparent);
}

.work-row:hover .row-meta,
.work-row:hover .row-index,
.work-row:hover .stack-item,
.work-row:hover .row-link {
  color: color-mix(in srgb, var(--color-invert-text) 60%, transparent);
}

.work-row:hover .stack-item {
  border-color: color-mix(in srgb, var(--color-invert-text) 25%, transparent);
}

@media (max-width: 720px) {
  .work-row {
    grid-template-columns: auto minmax(0, 1fr);
    gap: 8px 16px;
    padding: 24px var(--page-gutter);
  }

  .row-links {
    grid-column: 2;
    flex-direction: row;
    align-items: baseline;
    justify-content: flex-start;
    flex-wrap: wrap;
    gap: 14px;
    padding-top: 4px;
  }

  .row-title {
    font-size: 24px;
  }
}
</style>
