---
import { Image } from 'astro:assets';
import heroImage from '../../assets/me-hero.png';

import { basic, socialLinks } from '../../config/cv.json';

const findSocial = (icon: string) => socialLinks.find(s => s.icon === icon);

const github = findSocial('github');
const linkedin = findSocial('linkedin');

const actions = [
  { label: 'read the latest ↓', href: '#blog', external: false },
  github && { label: 'github ↗', href: github.link, external: true },
  linkedin && { label: 'linkedin ↗', href: linkedin.link, external: true },
].filter(Boolean) as { label: string; href: string; external: boolean }[];

const [first, second, third] = basic.headline;
---

<section class="hero">
  <!-- 01 — the numbered rail down the left edge -->
  <div class="rail" aria-hidden="true">
    <span>01</span>
    <span class="rail-name">{basic.name.toUpperCase()}</span>
    <span>&nbsp;</span>
  </div>

  <div class="copy">
    <div class="roles">
      {basic.roles.map(role => (
        <span class:list={['role', { accent: role.accent }]}>{role.label}</span>
      ))}
    </div>

    <h1 class="headline">
      {first}<br />{second}<br /><span class="accent-word">{third}</span>
    </h1>

    <p class="summary">{basic.summary}</p>

    <div class="actions">
      {actions.map(action => (
        <a
          href={action.href}
          class="action"
          target={action.external ? '_blank' : undefined}
          rel={action.external ? 'noopener noreferrer' : undefined}
        >{action.label}</a>
      ))}
    </div>
  </div>

  <div class="portrait-panel">
    <div class="grid-paper">
      <Image
        src={heroImage}
        alt={basic.name}
        width={874}
        loading="eager"
        class="portrait"
      />
    </div>
    <div class="panel-rule" aria-hidden="true"></div>
  </div>
</section>

<style>
.hero {
  position: relative;
  display: grid;
  grid-template-columns: var(--rail) 1fr 520px;
  border-bottom: 1px solid var(--color-border);
  min-height: 790px;
  overflow: hidden;
}

/* ── 01 rail ── */
.rail {
  border-right: 1px solid var(--color-border);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: center;
  padding: 24px 0;
  font-size: 10px;
  letter-spacing: 0.1em;
  color: var(--color-text-muted);
}

.rail-name {
  writing-mode: vertical-rl;
  letter-spacing: 0.3em;
}

/* ── Copy column ── */
.copy {
  padding: 56px 44px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 26px;
  position: relative;
  z-index: 2;
}

.roles {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  font-size: 10px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.role {
  padding: 3px 8px;
  border: 1px solid var(--color-border);
  color: var(--color-text-nav);
  white-space: nowrap;
}

.role.accent {
  border-color: var(--color-primary);
  color: var(--color-primary);
}

.headline {
  font-family: var(--font-display);
  font-size: clamp(38px, 6.2vw, 66px);
  font-weight: 700;
  line-height: 0.94;
  letter-spacing: -0.045em;
  text-transform: uppercase;
}

.accent-word {
  color: var(--color-primary);
}

.summary {
  font-size: 14px;
  line-height: 1.75;
  max-width: 46ch;
  color: var(--color-text-offset);
}

.actions {
  display: flex;
  border: 1px solid var(--color-border);
  width: fit-content;
  max-width: 100%;
  flex-wrap: wrap;
}

.action {
  padding: 12px 18px;
  font-size: 12px;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  white-space: nowrap;
  border-right: 1px solid var(--color-border);
  transition: background 0.15s ease, color 0.15s ease;
}

.action:last-child {
  border-right: none;
}

.action:hover {
  background: var(--color-invert-bg);
  color: var(--color-invert-text);
}

/* ── Portrait panel ── */
.portrait-panel {
  position: relative;
}

.grid-paper {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(var(--color-grid) 1px, transparent 1px),
    linear-gradient(90deg, var(--color-grid) 1px, transparent 1px);
  background-size: 40px 40px;
}

/* Cut out, grayscale, standing on the page with no panel behind it. */
.portrait {
  position: absolute;
  left: 279px;
  top: 74px;
  transform: translateX(-50%);
  width: 437px;
  height: 1029px;
  max-width: none;
  z-index: 1;
  filter: var(--portrait-filter);
}

.panel-rule {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 92px;
  width: 1px;
  background: var(--color-accent-line);
}

/* ── Responsive ───────────────────────────────────────────────
   The three-column frame holds to 1120px, then the portrait panel
   narrows, then it drops below the copy as a bleeding band. */

@media (max-width: 1180px) {
  .hero {
    grid-template-columns: var(--rail) 1fr 420px;
    min-height: 700px;
  }

  .portrait {
    left: 230px;
    top: 60px;
    width: 372px;
    height: 876px;
  }

  .panel-rule { left: 72px; }
}

@media (max-width: 980px) {
  .hero {
    grid-template-columns: var(--rail) 1fr;
    grid-template-rows: auto auto;
    min-height: 0;
  }

  .copy {
    padding: 44px 32px 48px;
    gap: 22px;
  }

  .rail {
    grid-row: 1 / span 2;
  }

  .portrait-panel {
    grid-column: 2;
    height: 460px;
    border-top: 1px solid var(--color-border);
  }

  .portrait {
    left: 50%;
    top: 34px;
    width: 320px;
    height: 753px;
  }

  .panel-rule { left: 64px; }
}

@media (max-width: 640px) {
  .hero {
    grid-template-columns: 1fr;
  }

  .rail { display: none; }

  .copy {
    padding: 36px var(--page-gutter) 40px;
    gap: 20px;
  }

  .portrait-panel {
    grid-column: 1;
    height: 380px;
  }

  .portrait {
    top: 28px;
    width: 260px;
    height: 612px;
  }

  .actions {
    width: 100%;
  }

  .action {
    flex: 1 1 auto;
    text-align: center;
    padding: 12px 14px;
  }
}

@media (max-width: 480px) {
  .actions {
    flex-direction: column;
  }

  .action {
    border-right: none;
    border-bottom: 1px solid var(--color-border);
  }

  .action:last-child {
    border-bottom: none;
  }
}
</style>
