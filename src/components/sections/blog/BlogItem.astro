---
import type { Blog } from '../../../types/BlogType';

interface Props {
  blog: Blog;
}

const { blog } = Astro.props;

const date = new Date(blog.data.datetime).toLocaleDateString('en-GB', {
  day: '2-digit', month: 'short', year: 'numeric',
});

const slug = `/blog/${blog.id.replace(/\.mdx?$/, '')}`;

const category = blog.data.category ?? 'General';
const type = blog.data.type ?? 'Article';
const timeToRead = blog.data.time_to_read ?? 5;
const level = blog.data.level ?? 'Anyone';
const tags = blog.data.tags ?? [];
---

<a href={slug} class="post-row">
  <div class="row-main">
    <div class="row-meta">
      <span class="row-category">{category}</span>
      <span>{date}</span>
      {tags.slice(0, 2).map(t => (
        <span class="row-tag">#{t.replace(/\s+/g, '-')}</span>
      ))}
    </div>

    <h2 class="row-title">{blog.data.title}</h2>

    {blog.data.description && <p class="row-desc">{blog.data.description}</p>}
  </div>

  <div class="row-side">
    <span>{type} · {timeToRead} min</span>
    <span>{level}</span>
    <span class="row-read">read →</span>
  </div>
</a>

<style>
.post-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 180px;
  gap: 24px;
  padding: 26px var(--page-gutter);
  border-bottom: 1px solid var(--color-border);
  transition: background 0.15s ease, color 0.15s ease;
}

.post-row:hover {
  background: var(--color-invert-bg);
  color: var(--color-invert-text);
}

.row-main {
  display: flex;
  flex-direction: column;
  gap: 10px;
  min-width: 0;
}

.row-meta {
  display: flex;
  align-items: baseline;
  gap: 12px;
  flex-wrap: wrap;
  font-size: 10px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--color-text-muted);
}

.row-category,
.row-read {
  color: var(--color-primary);
  white-space: nowrap;
}

.row-title {
  font-family: var(--font-display);
  font-size: 26px;
  font-weight: 700;
  line-height: 1.1;
  letter-spacing: -0.03em;
  text-transform: none;
}

.row-desc {
  font-size: 13px;
  line-height: 1.7;
  color: var(--color-text-offset);
  max-width: 68ch;
}

.row-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: space-between;
  gap: 8px;
  text-align: right;
  font-size: 10px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--color-text-muted);
}

/* Keep secondary text legible once the row inverts. */
.post-row:hover .row-desc {
  color: color-mix(in srgb, var(--color-invert-text) 72%, transparent);
}

.post-row:hover .row-meta,
.post-row:hover .row-side {
  color: color-mix(in srgb, var(--color-invert-text) 55%, transparent);
}

@media (max-width: 720px) {
  .post-row {
    grid-template-columns: minmax(0, 1fr);
    gap: 14px;
    padding: 22px var(--page-gutter);
  }

  .row-side {
    flex-direction: row;
    align-items: baseline;
    justify-content: flex-start;
    gap: 12px;
    flex-wrap: wrap;
    text-align: left;
  }

  .row-title {
    font-size: 22px;
  }
}
</style>
