---
interface Props {
  totalPosts: number;
  categories: string[];
  tags: string[];
  activeCategory?: string;
  activeTag?: string;
}

const { totalPosts, categories, tags, activeCategory, activeTag } = Astro.props;

const slugify = (s: string) => s.toLowerCase().replace(/\s+/g, '-');

const title = activeCategory ?? (activeTag ? `#${activeTag}` : 'All posts');

const note = activeCategory
  ? `in ${activeCategory}`
  : activeTag
    ? `tagged ${activeTag}`
    : 'published';
---

<div class="banner">
  <div class="banner-head gutter">
    <div class="head-left">
      <span class="number">01 /</span>
      <h1 class="banner-title">{title}</h1>
    </div>
    <span class="banner-count">
      {totalPosts} {totalPosts === 1 ? 'post' : 'posts'} {note}
    </span>
  </div>

  <div class="banner-controls gutter">
    <div class="search-wrap">
      <svg class="search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="11" cy="11" r="8" /><path d="m21 21-4.35-4.35" />
      </svg>
      <input
        id="blog-search"
        type="search"
        placeholder="search posts…"
        class="search-input"
        aria-label="Search blog posts"
        autocomplete="off"
      />
      <kbd class="search-kbd" aria-hidden="true">⌘K</kbd>
    </div>

    <div class="chip-row" role="list" aria-label="Filter by category">
      <a
        href="/blog"
        class:list={['chip', { active: !activeCategory && !activeTag }]}
        role="listitem"
      >all</a>
      {categories.map(cat => (
        <a
          href={`/blog/category/${slugify(cat)}`}
          class:list={['chip', { active: activeCategory === cat }]}
          role="listitem"
        >{cat}</a>
      ))}
    </div>

    {tags.length > 0 && (
      <div class="chip-row" role="list" aria-label="Filter by tag">
        {[...new Set(tags.flat())].sort().map(tag => (
          <a
            href={`/blog/tag/${slugify(tag)}`}
            class:list={['chip', 'chip-tag', { active: activeTag === tag }]}
            role="listitem"
          >#{slugify(tag)}</a>
        ))}
      </div>
    )}
  </div>
</div>

<!-- Search results overlay -->
<div id="search-results" class="search-results" aria-live="polite" hidden></div>

<style>
.banner {
  border-bottom: 1px solid var(--color-border);
}

.banner-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
  padding-top: 20px;
  padding-bottom: 20px;
  border-bottom: 1px solid var(--color-border);
  background: var(--color-background-offset);
}

.head-left {
  display: flex;
  align-items: baseline;
  gap: 16px;
  min-width: 0;
}

.number {
  font-size: 10px;
  letter-spacing: 0.14em;
  color: var(--color-text-muted);
}

.banner-title {
  font-family: var(--font-display);
  font-size: 22px;
  font-weight: 700;
  letter-spacing: -0.02em;
  text-transform: uppercase;
}

.banner-count {
  font-size: 10px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--color-text-muted);
}

.banner-controls {
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding-top: 16px;
  padding-bottom: 16px;
}

/* ── Search ── */
.search-wrap {
  position: relative;
  width: 100%;
  max-width: 340px;
}

.search-icon {
  position: absolute;
  left: 12px;
  top: 50%;
  transform: translateY(-50%);
  color: var(--color-text-muted);
  pointer-events: none;
}

.search-input {
  width: 100%;
  padding: 9px 52px 9px 34px;
  font-family: var(--font-mono);
  font-size: 12px;
  letter-spacing: 0.04em;
  border: 1px solid var(--color-border);
  background: transparent;
  color: var(--color-text);
  outline: none;
  transition: border-color 0.15s ease;
}

.search-input::placeholder {
  color: var(--color-text-muted);
}

.search-input:focus {
  border-color: var(--color-primary);
}

.search-input::-webkit-search-cancel-button {
  display: none;
}

.search-kbd {
  position: absolute;
  right: 10px;
  top: 50%;
  transform: translateY(-50%);
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: 0.06em;
  color: var(--color-text-muted);
  border: 1px solid var(--color-border);
  padding: 1px 5px;
  pointer-events: none;
}

/* ── Chips ── */
.chip-row {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
}

.chip {
  display: inline-flex;
  align-items: center;
  padding: 4px 10px;
  font-size: 10px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  border: 1px solid var(--color-border);
  color: var(--color-text-nav);
  white-space: nowrap;
  transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
}

.chip:hover {
  border-color: var(--color-primary);
  color: var(--color-primary);
}

.chip.active {
  background: var(--color-invert-bg);
  border-color: var(--color-invert-bg);
  color: var(--color-invert-text);
}

.chip-tag {
  color: var(--color-text-muted);
}

/* ── Search overlay shell ── */
.search-results {
  position: fixed;
  inset: 0;
  z-index: 200;
  background: color-mix(in srgb, var(--color-background) 88%, transparent);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding: 4rem 20px 20px;
}

.search-results[hidden] {
  display: none;
}

@media (max-width: 640px) {
  .search-wrap { max-width: none; }
  .search-kbd { display: none; }
}
</style>
