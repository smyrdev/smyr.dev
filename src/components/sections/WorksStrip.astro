---
import { getCollection } from 'astro:content';
import SectionHeader from '../common/SectionHeader.astro';
import WorkCard from './works/WorkCard.astro';

const allWorks = await getCollection('works');

const featured = allWorks
  .filter(w => w.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

// Same three-up rhythm as the blog strip above it.
const SLOTS = 3;
const fillers = Math.max(SLOTS - featured.length, 0);
---

{featured.length > 0 && (
  <section id="works" class="works-section">
    <SectionHeader
      number="03"
      title="Works"
      size="sm"
      note={`${allWorks.length} ${allWorks.length === 1 ? 'entry' : 'entries'}`}
      linkHref="/works"
      linkLabel="index →"
    />

    <div class="works-grid hairline-grid">
      {featured.map(work => <WorkCard work={work} />)}
      {Array.from({ length: fillers }).map(() => (
        <div class="work-empty" aria-hidden="true"></div>
      ))}
    </div>
  </section>
)}

<style>
.works-section {
  border-bottom: 1px solid var(--color-border);
}

.works-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.work-empty {
  background-color: var(--color-background);
  background-image:
    linear-gradient(var(--color-grid) 1px, transparent 1px),
    linear-gradient(90deg, var(--color-grid) 1px, transparent 1px);
  background-size: 40px 40px;
}

@media (max-width: 980px) {
  .works-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 640px) {
  .works-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  .work-empty {
    display: none;
  }
}
</style>
