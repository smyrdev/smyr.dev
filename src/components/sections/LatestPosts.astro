---
import { getCollection } from 'astro:content';
import SectionHeader from '../common/SectionHeader.astro';
import { syndication } from '../../config/cv.json';

const allBlog = await getCollection('blog');

const latest = allBlog
  .sort((a, b) => new Date(b.data.datetime).getTime() - new Date(a.data.datetime).getTime())
  .slice(0, 3);

const getSlug = (id: string) => id.replace(/\.mdx?$/, '');

// "19 jun 2026" — rendered uppercase by the meta row.
const formatDate = (d: string) => new Date(d).toLocaleDateString('en-GB', {
  day: '2-digit', month: 'short', year: 'numeric',
});

const slugifyTag = (t: string) => t.toLowerCase().replace(/\s+/g, '-');

const tags = [...new Set(allBlog.flatMap(p => p.data.tags ?? []))].slice(0, 3);

// The strip is a three-up. With fewer posts than that, hold the rhythm with
// empty graph-paper cells rather than stretching one card across the page.
const SLOTS = 3;
const fillers = Math.max(SLOTS - latest.length, 0);
---

<section id="blog" class="blog-section">
  <SectionHeader
    number="02"
    title="Blog"
    size="lg"
    offset={true}
    linkHref="/blog"
    linkLabel="all posts →"
  />

  {latest.length > 0 ? (
    <div class="cards hairline-grid">
      {latest.map(post => (
        <a href={`/blog/${getSlug(post.id)}`} class="card">
          <div class="card-top">
            <span class="card-category">{post.data.category}</span>
            <span>{formatDate(post.data.datetime)}</span>
          </div>

          <h3 class="card-title">{post.data.title}</h3>

          {post.data.description && (
            <p class="card-desc">{post.data.description}</p>
          )}

          <div class="card-bottom">
            <span>{post.data.type} · {post.data.time_to_read} min</span>
            <span class="card-read">read →</span>
          </div>
        </a>
      ))}

      {Array.from({ length: fillers }).map(() => (
        <div class="card card-empty" aria-hidden="true"></div>
      ))}
    </div>
  ) : (
    <p class="empty gutter">Nothing published yet.</p>
  )}

  <div class="tagbar gutter">
    <div class="tag-list">
      {tags.map(tag => (
        <a href={`/blog/tag/${slugifyTag(tag)}`} class="tag">#{slugifyTag(tag)}</a>
      ))}
    </div>
    <span class="syndication">one source → {syndication.join(' · ')}</span>
  </div>
</section>

<style>
.blog-section {
  border-bottom: 1px solid var(--color-border);
}

/* Dividers come from .hairline-grid; this only sets the track count. */
.cards {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

/* Unfilled slot — same graph paper as the hero panel. */
.card-empty {
  background-color: var(--color-background);
  background-image:
    linear-gradient(var(--color-grid) 1px, transparent 1px),
    linear-gradient(90deg, var(--color-grid) 1px, transparent 1px);
  background-size: 40px 40px;
}

.card {
  display: flex;
  flex-direction: column;
  gap: 14px;
  padding: 32px;
  min-height: 300px;
  background: var(--color-background);
  transition: background 0.15s ease, color 0.15s ease;
}

.card:hover {
  background: var(--color-invert-bg);
  color: var(--color-invert-text);
}

.card-top,
.card-bottom {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 12px;
  font-size: 10px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--color-text-muted);
}

.card-bottom {
  margin-top: auto;
}

.card-category,
.card-read {
  color: var(--color-primary);
  white-space: nowrap;
}

.card-title {
  font-family: var(--font-display);
  font-size: 30px;
  font-weight: 700;
  line-height: 1.08;
  letter-spacing: -0.03em;
  text-transform: none;
}

.card-desc {
  font-size: 13px;
  line-height: 1.7;
  color: var(--color-text-offset);
}

/* The mock's card body keeps its dark grey on hover, which goes
   invisible against the inverted ground — lift it instead. */
.card:hover .card-desc {
  color: color-mix(in srgb, var(--color-invert-text) 72%, transparent);
}

.card:hover .card-top,
.card:hover .card-bottom {
  color: color-mix(in srgb, var(--color-invert-text) 55%, transparent);
}

.empty {
  padding-top: 32px;
  padding-bottom: 32px;
  font-size: 13px;
  color: var(--color-text-muted);
}

/* ── Tag bar ── */
.tagbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px 20px;
  flex-wrap: wrap;
  padding-top: 12px;
  padding-bottom: 12px;
  border-top: 1px solid var(--color-border);
  font-size: 10px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--color-text-muted);
}

.tag-list {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.tag {
  transition: color 0.15s ease;
}

.tag:hover {
  color: var(--color-primary);
}

@media (max-width: 980px) {
  .cards {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .card {
    min-height: 260px;
    padding: 26px;
  }

  .card-title {
    font-size: 26px;
  }
}

@media (max-width: 640px) {
  .cards {
    grid-template-columns: minmax(0, 1fr);
  }

  .card {
    padding: 24px var(--page-gutter);
    min-height: 0;
  }

  /* No point holding empty slots once the grid is a single column. */
  .card-empty {
    display: none;
  }

  .syndication {
    width: 100%;
  }
}
</style>
