---
import Layout from '../layouts/Layout.astro';
import SectionHead from '../components/SectionHead.astro';
import { basic } from '../config/cv.json';
import { dotted } from '../lib/format';

// ── Edit this block, not the markup. ──────────────────────────────
// Bump `updated` whenever you change anything below it.
const updated = '2026-07-31';

const work = [
  {
    label: 'working',
    body: `full time software engineer @code-factory (DKB), based in Berlin`,
  },
  {
    label: 'focusing',
    body: `next step in my career, and the next thing I want to learn`,
  },
];

const offScreen = [
  { label: 'reading', body: `Lean Startup by Eric Ries` },
  { label: 'learning', body: `Agentic AIs, Startups, Deutsch` },
  {
    label: 'training',
    body: `5 days of strength training, morning 5ks, 10k steps per day, road to sub 10% bf`,
  },
];

const uses = [
  { label: 'laptop', body: 'lenovo ideapad pro 5' },
  { label: 'languages', body: 'Java, Kotlin, TS, Python' },
  { label: 'editor', body: 'VS Code' },
  { label: 'ai', body: 'claude max' },
  { label: 'notes', body: 'notion' },
];
// ──────────────────────────────────────────────────────────────────
---

<Layout
  title="Now"
  description="What Samyar Rahimi is working on, writing and reading at the moment."
>
  <section class="intro">
    <div class="heading">
      <h1 class="page-title">Now</h1>
      <span class="stamp">updated {dotted(updated)}</span>
    </div>

    <p class="prose prose-muted">
      A snapshot of what has my attention at the moment, in the spirit of
      <a
        href="https://nownownow.com/about"
        class="link-underline"
        target="_blank"
        rel="noopener noreferrer"
      >nownownow.com</a>. If it looks stale, it probably is — the date above
      is the honest one.
    </p>
  </section>

  <section class="section">
    <SectionHead number="01" title="work" />
    <ul class="list">
      {work.map(item => (
        <li class="row">
          <span class="meta">{item.label}</span>
          <span>{item.body}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="section">
    <SectionHead number="02" title="off screen" />
    <ul class="list">
      {offScreen.map(item => (
        <li class="row">
          <span class="meta">{item.label}</span>
          <span>{item.body}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="section">
    <SectionHead number="03" title="uses" />
    <ul class="list">
      {uses.map(item => (
        <li class="row">
          <span class="meta">{item.label}</span>
          <span>{item.body}</span>
        </li>
      ))}
    </ul>
  </section>

  <p class="closing">
    Want to talk about one of these? <a
      href={`mailto:${basic.email}`}
      class="link-underline"
    >{basic.email}</a>
  </p>
</Layout>

<style>
.intro {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20px;
}

.stamp {
  font-family: var(--font-mono);
  font-size: 11.5px;
  letter-spacing: 0.06em;
  color: var(--muted);
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 14px;
  font-size: 16px;
  line-height: 1.6;
}

.closing {
  font-size: 15.5px;
  line-height: 1.7;
  color: var(--muted);
}
</style>
