---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/common/SectionHeader.astro';
import ContactBand from '../components/sections/ContactBand.astro';
import heroImage from '../assets/me-hero.png';
import { basic, socialLinks } from '../config/cv.json';

const principles = [
  {
    number: '01',
    title: 'Architecture is code',
    body: `A diagram drawn once drifts by week three and nothing fails when it
      does. Define the boundaries in code, assert them in tests, and generate
      the picture from the source.`,
  },
  {
    number: '02',
    title: 'Boring on purpose',
    body: `Most systems do not need to be clever. They need to be legible at
      3am by someone who did not write them. I optimise for the reader, and the
      reader is usually future-us.`,
  },
  {
    number: '03',
    title: 'Explicit beats implicit',
    body: `If a rule matters, it should be somewhere a test can find it. Tribal
      knowledge is a single point of failure wearing a friendly face.`,
  },
  {
    number: '04',
    title: 'Ship the smallest proof',
    body: `The fastest way to learn whether a shape is right is to put a thin
      version of it in front of real traffic. Design documents do not survive
      contact; deployed code does.`,
  },
];
---

<Layout
  title="About"
  description={`${basic.name} — ${basic.role}. ${basic.tagline}`}
>
  <SectionHeader number="01" title="About" size="lg" note={basic.role} />

  <section class="intro">
    <div class="intro-copy gutter">
      <h1 class="intro-headline">
        I build systems and the<br />products on top of them
      </h1>

      <div class="prose-block">
        <p>
          I'm {basic.name} — a software engineer and architect with about ten
          years of shipping behind me. Most of that has been spent on the same
          problem in different costumes: making the structure of a system
          explicit enough that a team can change it without holding their breath.
        </p>
        <p>
          In practice that means I spend less time drawing boxes and more time
          encoding them — module boundaries defined in code, dependency rules
          asserted in the test suite, diagrams generated rather than maintained.
          When the architecture is a build artefact instead of a document, it
          stops drifting.
        </p>
        <p>
          I have also founded products, which is the fastest education in what
          architecture is actually for. Constraints stop being theoretical when
          you are the one paying for the extra week.
        </p>
        <p>
          I write about all of it here. Posts are drafted once and syndicated
          out to dev.to, Hashnode and Medium, but this is the source.
        </p>
      </div>
    </div>

    <div class="intro-portrait">
      <div class="grid-paper">
        <Image src={heroImage} alt={basic.name} width={620} class="portrait" />
      </div>
      <div class="panel-rule" aria-hidden="true"></div>
    </div>
  </section>

  <SectionHeader number="02" title="How I work" size="sm" />

  <div class="principles hairline-grid">
    {principles.map(principle => (
      <article class="principle">
        <span class="principle-number">{principle.number}</span>
        <h2 class="principle-title">{principle.title}</h2>
        <p class="principle-body">{principle.body}</p>
      </article>
    ))}
  </div>

  <SectionHeader number="03" title="Elsewhere" size="sm" />

  <div class="elsewhere hairline-grid">
    {socialLinks.map(social => (
      <a
        href={social.link}
        class="social"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="social-name">{social.name}</span>
        <span class="social-arrow" aria-hidden="true">↗</span>
      </a>
    ))}
  </div>

  <ContactBand number="04" heading="Let's talk architecture" />
</Layout>

<style>
.intro {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 420px;
  border-bottom: 1px solid var(--color-border);
  overflow: hidden;
}

.intro-copy {
  padding-top: 44px;
  padding-bottom: 48px;
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.intro-headline {
  font-family: var(--font-display);
  font-size: clamp(30px, 4.4vw, 46px);
  font-weight: 700;
  line-height: 1;
  letter-spacing: -0.045em;
  text-transform: uppercase;
}

.prose-block {
  display: flex;
  flex-direction: column;
  gap: 16px;
  max-width: 62ch;
}

.prose-block p {
  font-size: 14px;
  line-height: 1.85;
  color: var(--color-text-offset);
}

/* ── Portrait panel ── */
.intro-portrait {
  position: relative;
  border-left: 1px solid var(--color-border);
  min-height: 520px;
}

.grid-paper {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(var(--color-grid) 1px, transparent 1px),
    linear-gradient(90deg, var(--color-grid) 1px, transparent 1px);
  background-size: 40px 40px;
}

.portrait {
  position: absolute;
  left: 55%;
  top: 40px;
  transform: translateX(-50%);
  width: 310px;
  height: 729px;
  max-width: none;
  filter: var(--portrait-filter);
}

.panel-rule {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 72px;
  width: 1px;
  background: var(--color-accent-line);
}

/* ── Principles ── */
.principles {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  border-bottom: 1px solid var(--color-border);
}

.principle {
  background: var(--color-background);
  padding: 26px var(--page-gutter);
  display: flex;
  flex-direction: column;
  gap: 10px;
  transition: background 0.15s ease, color 0.15s ease;
}

.principle:hover {
  background: var(--color-invert-bg);
  color: var(--color-invert-text);
}

.principle-number {
  font-size: 10px;
  letter-spacing: 0.14em;
  color: var(--color-primary);
}

.principle-title {
  font-family: var(--font-display);
  font-size: 20px;
  font-weight: 700;
  letter-spacing: -0.02em;
  text-transform: uppercase;
}

.principle-body {
  font-size: 13px;
  line-height: 1.75;
  color: var(--color-text-offset);
}

.principle:hover .principle-body {
  color: color-mix(in srgb, var(--color-invert-text) 72%, transparent);
}

/* ── Elsewhere ── */
.elsewhere {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  border-bottom: 1px solid var(--color-border);
}

.social {
  background: var(--color-background);
  padding: 18px var(--page-gutter);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  font-size: 11px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  transition: background 0.15s ease, color 0.15s ease;
}

.social:hover {
  background: var(--color-invert-bg);
  color: var(--color-invert-text);
}

.social-arrow {
  color: var(--color-primary);
}

@media (max-width: 980px) {
  .intro {
    grid-template-columns: minmax(0, 1fr);
  }

  .intro-portrait {
    border-left: none;
    border-top: 1px solid var(--color-border);
    min-height: 380px;
  }

  .portrait {
    left: 50%;
    top: 30px;
    width: 250px;
    height: 588px;
  }
}

@media (max-width: 640px) {
  .principles {
    grid-template-columns: minmax(0, 1fr);
  }

  .intro-copy {
    padding-top: 32px;
    padding-bottom: 36px;
  }

  .intro-portrait {
    min-height: 320px;
  }

  .portrait {
    width: 210px;
    height: 494px;
  }
}
</style>
