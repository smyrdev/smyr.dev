---
import Layout from '../layouts/Layout.astro';
import SectionHead from '../components/SectionHead.astro';
import { basic, socialLinks, syndication } from '../config/cv.json';

const principles = [
  {
    title: 'consistency',
    body: `You heard it almost million times, but it is true. Consistency is the key to great success. A consistent
    person can beat a motived one all the time.`,
  },
  {
    title: 'hard work',
    body: `Controlling dopamine is the key to long term success. I try to make my life boring and hard on purpose, so I can focus on the things that matter.`,
  },
  {
    title: 'systems',
    body: `Create a system that works, and you can stick to it on autopilot.`,
  },
  {
    title: 'momentum',
    body: `Momentum is the last key, keep never skip your system twice in a row, otherwise you need to start over, build a life that does not need any vacation.`,
  },
];

const elsewhere = [
  { label: 'email', value: basic.email, href: `mailto:${basic.email}` },
  ...socialLinks.map(social => ({
    label: social.name.toLowerCase(),
    value: social.handle,
    href: social.link,
  })),
  { label: 'cv', value: "cv", href: 'https://cv.smyr.dev' },
];
---

<Layout
  title="About"
  description={`${basic.name} — ${basic.role}. ${basic.tagline}`}
>
  <section class="intro">
    <h1 class="page-title">About</h1>

    <p class="prose">
      I'm {basic.name} — a software engineer and architect with about ten
      years of shipping behind me. Most of that has been spent on the same
      problem in different costumes: making the structure of a system
      explicit enough that a team can change it without holding their breath.
    </p>

    <p class="prose">
      In practice that means I spend less time drawing boxes and more time
      encoding them — module boundaries defined in code, dependency rules
      asserted in the test suite, diagrams generated rather than maintained.
      When the architecture is a build artefact instead of a document, it
      stops drifting.
    </p>

    <p class="prose prose-muted">
      I have also founded products, which is the fastest education in what
      architecture is actually for. Constraints stop being theoretical when
      you are the one paying for the extra week.
    </p>

    <p class="prose prose-muted">
      I write about all of it here. Posts are drafted once and syndicated out
      to {syndication.join(', ')}, but this is the source. My fitness life
      lives at <a
        href="https://samy.fit"
        class="link-underline"
        target="_blank"
        rel="noopener noreferrer"
      >samy.fit</a>.
    </p>
  </section>

  <section class="section">
    <SectionHead number="01" title="how I work" />

    <ul class="list">
      {principles.map(principle => (
        <li class="row">
          <span class="meta">{principle.title}</span>
          <p class="body">{principle.body}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="section">
    <SectionHead number="02" title="elsewhere" />

    <ul class="list tight">
      {elsewhere.map(item => (
        <li class="row">
          <span class="meta">{item.label}</span>
          <span>
            <a
              href={item.href}
              class="link-underline"
              target={item.href.startsWith('mailto:') ? undefined : '_blank'}
              rel={item.href.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
            >{item.value}</a>
          </span>
        </li>
      ))}
    </ul>
  </section>
</Layout>

<style>
.intro {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 18px;
  font-size: 16px;
  line-height: 1.6;
}

.tight {
  gap: 12px;
}

.body {
  font-size: 16px;
  line-height: 1.7;
  color: var(--muted);
  text-wrap: pretty;
}
</style>
