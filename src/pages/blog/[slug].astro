---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { dotted } from '../../lib/format';

const slugOf = (id: string) => id.replace(/\.mdx?$/, '');

export const getStaticPaths = async () => {
    const sorted = (await getCollection('blog'))
        .sort((a, b) => +new Date(b.data.datetime) - +new Date(a.data.datetime));

    return sorted.map((item, i) => ({
        params: { slug: item.id.replace(/\.mdx?$/, '') },
        // The "next" link walks backwards in time, matching the reading order
        // of the index above it.
        props: { blog: item, next: sorted[i + 1] ?? null },
    }));
};

type Props = {
  blog: CollectionEntry<'blog'>;
  next: CollectionEntry<'blog'> | null;
};

const { blog, next } = Astro.props;
const { Content } = await render(blog);
---

<Layout title={blog.data.title} description={blog.data.description}>
  <article class="post">
    <header class="post-header">
      <div class="byline">
        <time datetime={blog.data.datetime}>{dotted(blog.data.datetime)}</time>
        <span aria-hidden="true">·</span>
        <span>{blog.data.time_to_read} min</span>
        <span aria-hidden="true">·</span>
        <span class="accent">{blog.data.category.toLowerCase()}</span>
      </div>

      <h1 class="post-title">{blog.data.title}</h1>
    </header>

    {/* The Notion sync writes an empty string when a post has no summary. */}
    {blog.data.description && <p class="lede">{blog.data.description}</p>}

    <div class="article">
      <Content />
    </div>
  </article>

  <nav class="post-nav" aria-label="Post">
    <a href="/blog" class="link-quiet">← all writing</a>

    {next && (
      <a href={`/blog/${slugOf(next.id)}`} class="link-quiet next">
        {next.data.title} →
      </a>
    )}
  </nav>
</Layout>

<style>
.post {
  display: flex;
  flex-direction: column;
  gap: 28px;
}

.post-header {
  display: flex;
  flex-direction: column;
  gap: 14px;
  padding-bottom: 24px;
  border-bottom: 1px solid var(--line);
}

.byline {
  display: flex;
  align-items: baseline;
  gap: 14px;
  flex-wrap: wrap;
  font-family: var(--font-mono);
  font-size: 12px;
  letter-spacing: 0.04em;
  color: var(--muted);
  font-variant-numeric: tabular-nums;
}

.post-title {
  font-size: 27px;
  font-weight: 500;
  line-height: 1.28;
  letter-spacing: -0.02em;
  text-wrap: pretty;
}

.post-nav {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20px;
  padding-top: 24px;
  border-top: 1px solid var(--line);
  font-family: var(--font-mono);
  font-size: 12.5px;
  color: var(--muted);
}

/* With only one post there is no next link, and `space-between` would
   otherwise leave "all writing" centred. */
.next {
  margin-left: auto;
  max-width: 60%;
  text-align: right;
}
</style>
