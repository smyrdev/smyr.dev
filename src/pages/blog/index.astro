---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { dotted } from '../../lib/format';

const posts = (await getCollection('blog'))
  .sort((a, b) => +new Date(b.data.datetime) - +new Date(a.data.datetime));

const slug = (id: string) => id.replace(/\.mdx?$/, '');
---

<Layout
  title="Writing"
  description="Notes on Life, Dev things, and other stuff."
>
  <section class="head">
    <h1 class="page-title">Writing</h1>
    <p class="prose prose-muted">
      Notes on Life, Dev things, and other stuff.
    </p>
  </section>

  {posts.length > 0 ? (
    <ol class="rows">
      {posts.map((post, i) => (
        <li>
          <a href={`/blog/${slug(post.id)}`} class="entry">
            <span class="meta num">{String(i + 1).padStart(2, '0')}</span>
            <span class="meta date">{dotted(post.data.datetime)}</span>
            <span class="title">{post.data.title}</span>
            <span class="meta read">{post.data.time_to_read} min</span>
          </a>
        </li>
      ))}
    </ol>
  ) : (
    <p class="prose prose-muted">Nothing published yet.</p>
  )}
</Layout>

<style>
.head {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.entry {
  display: grid;
  grid-template-columns: 28px var(--col-meta) 1fr auto;
  gap: 16px;
  align-items: baseline;
  padding: 16px 0;
  transition: color 0.15s ease;
}

.entry > * {
  min-width: 0;
}

.entry:hover {
  color: var(--accent);
}

.entry:hover .meta {
  color: inherit;
}

.num {
  font-size: 12px;
}

.read {
  font-size: 11.5px;
}

.title {
  font-size: 16px;
  line-height: 1.5;
  text-wrap: pretty;
}

/* Four columns will not fit a phone. Fold the three mono cells onto one
   line and give the title the row below it. */
@media (max-width: 560px) {
  .entry {
    grid-template-columns: auto auto 1fr;
    gap: 4px 10px;
    padding: 14px 0;
  }

  .num { grid-area: 1 / 1; }
  .date { grid-area: 1 / 2; }
  .read { grid-area: 1 / 3; }
  .title { grid-area: 2 / 1 / 3 / 4; }
}
</style>
