{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smyr-dev",
  "compatibility_date": "2026-09-23",
  // Cloudflare creates and manages the DNS records for these
  "routes": [
    { "pattern": "smyr.dev", "custom_domain": true },
    { "pattern": "www.smyr.dev", "custom_domain": true }
  ],
  // Static site only: serve the Astro build output, no Worker script
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
